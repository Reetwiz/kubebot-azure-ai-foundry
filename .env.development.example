# Use this file only for local development. Packaged installs configure the provider interactively.
KUBEBOT_LLM_PROVIDER=ollama
KUBEBOT_ENV=development

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Azure alternative
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_CHAT_DEPLOYMENTS=mini=gpt-4.1-mini,standard=gpt-4.1

# Optional diagnostics
USER_AGENT=KubeBot/0.2.1
LANGCHAIN_TRACING_V2=false