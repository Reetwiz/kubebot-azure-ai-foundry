# Provider: azure or ollama. Leave blank to choose at interactive startup.
KUBEBOT_LLM_PROVIDER=

# Azure OpenAI (Azure AI Foundry)
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Optional: named chat deployments KubeBot can switch between at runtime via
# '/model <label>' (e.g. '/model standard'). Each deployment must already
# exist in the Azure AI Foundry resource -- switching never creates one.
AZURE_OPENAI_CHAT_DEPLOYMENTS=mini=gpt-4.1-mini,standard=gpt-4.1

# Local Ollama fallback (no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
KUBEBOT_OLLAMA_FALLBACK=true

USER_AGENT="AKS-Diagnostic-Assistant/1.0"

# development = verbose tool-call tracing, RAG debug prints, full tracebacks on error
# production = minimal, clean output (default)
KUBEBOT_ENV=production

LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT="AKS-Diagnostic-Assistant"
